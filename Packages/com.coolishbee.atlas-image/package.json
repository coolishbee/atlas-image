        "url": "https://github.com/coolishbee/atlas-image.git"
    },
    "keywords": [
        "ugui",
        "image",
        "sprite",
        "spriteatlas",
        "atlas"
    ],
    "dependencies": {
        "com.unity.ugui": "2.0.0",
        "com.unity.2d.sprite": "1.0.0"
    },
    "samples": [
        {
            "displayName": "AtlasImage Sample",
            "description": "A sample that displays atlas sprites and switches them by name using UI buttons.",
            "path": "Samples~/AtlasImageSample"
        }
    ],
    "documentationUrl": "https://github.com/coolishbee/atlas-image/blob/main/Packages/com.coolishbee.atlas-image/README.md"
